# Local runtime and Python bytecode
node_modules/
__pycache__/
*.py[cod]
.venv/
dist/
*.log

# Release QA keeps verified installers and extracted runtimes local.
/audit/artifacts/release-*/*.exe
/audit/artifacts/release-*/payload/
/audit/artifacts/release-*/previous-runtime/
/audit/artifacts/release-*/profile*/

# Native smoke profiles contain Chromium caches; keep only reviewed evidence.
/audit/artifacts/living-dex-desktop-*/**
!/audit/artifacts/living-dex-desktop-*/*.png
!/audit/artifacts/living-dex-desktop-*/smoke.json

# Local configuration and collection exports
.env
.env.*
shinydex-backup*.json

# Browser QA captures; source images remain in assets/
*-preview.png
*-preview.jpg

# Reviewed audit artifacts are versioned in their canonical workspace.
!audit/artifacts/**/*-preview.png
!audit/artifacts/**/*-preview.jpg
!audit/artifacts/*-preview.png
!audit/artifacts/*-preview.jpg

# Local repository-creation UI evidence is not project source.
/Archive/github-repository-prepared.png
/audit/artifacts/update-skip-qa/**
!/audit/artifacts/update-skip-qa/*.png
!/audit/artifacts/update-skip-qa/result.json
/audit/artifacts/release-1.1.1-smoke/**
!/audit/artifacts/release-1.1.1-smoke/*.png
!/audit/artifacts/release-1.1.1-smoke/smoke.json

# Isolated layout QA profiles: retain reviewed images and smoke reports only.
/audit/artifacts/pokedex-ui-*-qa/**
!/audit/artifacts/pokedex-ui-*-qa/*.png
!/audit/artifacts/pokedex-ui-*-qa/smoke.json
/audit/artifacts/responsive-desktop-qa*/**
!/audit/artifacts/responsive-desktop-qa*/*.png
!/audit/artifacts/responsive-desktop-qa*/smoke.json
/audit/artifacts/form-gallery-desktop-qa*/**
!/audit/artifacts/form-gallery-desktop-qa*/*.png
!/audit/artifacts/form-gallery-desktop-qa*/smoke.json
